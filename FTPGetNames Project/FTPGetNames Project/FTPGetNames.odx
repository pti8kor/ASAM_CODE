[Microsoft.XLANGs.BaseTypes.BPELExportable(false)]
module FTPGetNames_Project
{
    public porttype PortType_1
    {
        requestresponse Operation_1
        {
            FTPGetNamesSchema, FTPGetNamesSchema
        };
    };
    internal porttype PortType_2
    {
        oneway Operation_1
        {
            FTPGetNamesSchema
        };
    };
    [Microsoft.XLANGs.BaseTypes.BPELExportable(false)]
    [Microsoft.XLANGs.BaseTypes.Transaction(Retry=true,Batch=true,Timeout=60,TranIsolationLevel=System.Data.IsolationLevel.Serializable)]
    internal service atomic transaction FTPGetNames
    {
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port implements PortType_1 RR_P;
        message FTPGetNamesSchema Message_1;
        message FTPGetNamesSchema Message_2;
        System.String FileList;
        System.String tmpStr;
        RB.FTPLibrary.FTPHandler FTPHandler1;
        System.String TargetSystem;
        RB.BTLoggerLibrary.BTLogger ROBTLogger;
        RB.BTLoggerLibrary.Logger ROLogger;
        body ()
        {
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("7207a16f-61ae-4f16-a373-9062e1b539ff")]
            activate receive (RR_P.Operation_1, Message_1);
            FileList = "";
            tmpStr = "";
            TargetSystem = "";
            ROBTLogger = new RB.BTLoggerLibrary.BTLogger();
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("6e18c5e4-f6a9-474d-87ec-d30d45838af3")]
             ROLogger  = ROBTLogger.GetLogger(Message_1.InterfaceName,Message_1.XProtID);
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("b83220af-db08-4551-b45e-21ba07e71944")]
            construct Message_2
            {
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("d4f93c1b-4d6b-4a3e-bd3b-2ee54ae44aca")]
                     Message_2 = Message_1;
                
                
                    //Exception-Handling missing ...
                
                    tmpStr = System.Convert.ToString(Message_1.InterfaceName);
                    TargetSystem = System.Convert.ToString(Message_1.RQ1System);
                    
                    FTPHandler1 = new RB.FTPLibrary.FTPHandler(tmpStr, TargetSystem);     
                   
                     ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmss - }", System.DateTime.Now) + "FTPGetNames : " + "FTP testing-->Handler= " + FTPHandler1.FTPHandlerValid.ToString(), ROLogger);  
                    FileList = FTPHandler1.FTPDirectoryList();
                
                    Message_2.FTPFileNames = FileList;
                
                    ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmss - }", System.DateTime.Now) + "FTPGetNames : " + "FTP directory listing -> " + FileList, ROLogger);  
                
                    ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmss - }", System.DateTime.Now) + "FTPGetNames : " + "InterfaceName -> " + tmpStr, ROLogger);
                
                    ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmss - }", System.DateTime.Now) + "FTPGetNames : " + "XPROT ID -> " + System.Convert.ToString(Message_1.XProtID),
                    ROLogger);
                
                
                    // no log in XProt necessary because this routine is only for choicelist value generation
            }
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("e09fb6b7-c22f-40ac-88a8-8323bbadd6ee")]
            ROBTLogger.CloseLogger(ROLogger);
            
            
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("29065c64-7161-4de9-b46d-2d5b83d67e23")]
            send (RR_P.Operation_1, Message_2);
        }
    }
}

