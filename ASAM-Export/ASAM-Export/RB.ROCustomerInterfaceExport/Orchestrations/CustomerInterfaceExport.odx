[Microsoft.XLANGs.BaseTypes.BPELExportable(false)]
module RB.ROCustomerInterfaceExport
{
    public porttype PortType_1
    {
        oneway Operation_1
        {
            Schemas.Transfer.TransferResultInformation
        };
    };
    [Microsoft.XLANGs.BaseTypes.BPELExportable(false)]
    internal service CustomerInterfaceExport
    {
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port implements PortType_1 ftpTransferRecPort_Export;
        message Schemas.Transfer.TransferResultInformation msgFTPTransfer;
        System.String sDownloadTargetPath;
        System.String sInterfaceName;
        System.String sExchangeProtocolID;
        System.String sSystem;
        System.String sLifeToken4Xprot;
        System.String sLifeToken4Files;
        System.String sMode;
        System.String sConfigPath;
        RB.ROCustomerInterfaceExportLibrary.Logger ROLogger;
        RB.ROCustomerInterfaceExportLibrary.BTHelper ROCustomerExportLibrary;
        System.Int32 recordsCount;
        System.Int32 batchCount;
        System.Int32 index;
        RB.ROCustomerInterfaceExportLibrary.AsyncLogger asyncLogger;
        System.String sStatus;
        body ()
        {
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("a2bf78e8-d9c6-4247-b799-33330ba09706")]
            activate receive (ftpTransferRecPort_Export.Operation_1, msgFTPTransfer);
            sDownloadTargetPath = "";
            sInterfaceName = "";
            sExchangeProtocolID = "";
            sSystem = "";
            sLifeToken4Xprot = "";
            sLifeToken4Files = "";
            sMode = "";
            sConfigPath = "";
            ROCustomerExportLibrary = new RB.ROCustomerInterfaceExportLibrary.BTHelper();
            recordsCount = 0;
            batchCount = 0;
            sStatus = "";
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("be1034e9-485f-414e-b4f8-a79cdfbb72d0")]
            System.Diagnostics.EventLog.WriteEntry("ROINTERFACE_Export","Export - Interface run starts" );
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("a0145f68-9eed-4995-aafe-422b7909c2bc")]
            System.Diagnostics.EventLog.WriteEntry("ROINTERFACE_Export","Setting Variables starts" );
            
            sInterfaceName = msgFTPTransfer.InterfaceName;
            sDownloadTargetPath=msgFTPTransfer.DownloadTargetPath;
            sExchangeProtocolID = msgFTPTransfer.XProtID;
            sSystem = msgFTPTransfer.RQ1System;
            sLifeToken4Files = msgFTPTransfer.LifeToken4Files;
            sLifeToken4Xprot = msgFTPTransfer.LifeToken4XProt;
            
            sMode = msgFTPTransfer.Mode;
            
            
            
            System.Diagnostics.EventLog.WriteEntry("ROINTERFACE_Export","Interface name ="+ sInterfaceName);
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("77ac079c-bc6f-49f3-82db-2108c0bde289")]
            sConfigPath = ROCustomerExportLibrary.GetConfigPathForLogger(sInterfaceName,sExchangeProtocolID);
            System.Diagnostics.EventLog.WriteEntry("ROINTERFACE_EXPORT","sConfigPath="+sConfigPath);
            ROLogger = new RB.ROCustomerInterfaceExportLibrary.Logger(sConfigPath);
            
            ROCustomerExportLibrary.SetLoggingMode(sInterfaceName,ROLogger);
            
            ROLogger.LogInfo("Log set");
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("63209d35-1dce-47f5-9d97-4ca6f95c8ceb")]
            recordsCount = ROCustomerExportLibrary.GetRecordsCount(sLifeToken4Files, ROLogger);
            
            batchCount = ROCustomerExportLibrary.GetBatchCount(recordsCount, ROLogger);
            
            
            index = 1;
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("2c9c5397-547b-44ce-af6d-ab55d38ec9b0")]
            while (index <= batchCount)
            {
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("00b2eb50-6c93-4b2f-977e-612978b6cc33")]
                call RB.ROCustomerInterfaceExport.ValidateandExecute (ROLogger, batchCount, ref sLifeToken4Files, sExchangeProtocolID, ROCustomerExportLibrary, sSystem, sInterfaceName, index);
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("23a60b78-1d59-4017-96a5-3ae4679f5aec")]
                index = index + 1;
            }
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("7094dc66-aae7-451d-a1d1-5b7a79b9ab57")]
            sLifeToken4Xprot = ROCustomerExportLibrary.ChangeLifeToken4Xprot(sLifeToken4Files,sLifeToken4Xprot);
            sStatus = ROCustomerExportLibrary.UpdateExchangeProtocol(sExchangeProtocolID,sSystem,sInterfaceName,sLifeToken4Files, sLifeToken4Xprot);
            ROCustomerExportLibrary.DeleteStageLock(sExchangeProtocolID);
        }
    }
}

