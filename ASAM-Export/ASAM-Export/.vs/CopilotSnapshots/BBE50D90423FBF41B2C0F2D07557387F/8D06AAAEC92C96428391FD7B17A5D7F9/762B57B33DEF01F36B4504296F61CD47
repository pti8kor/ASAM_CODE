                            attributeString = "oslc.properties=" + attributeString;

                            oQuery = baseUrl + "?rcm.action=modify&" + attributeString;
                        }

                    }
                }
            }

            catch (Exception ex)
            {
                if (objLogger != null)
                {
                    objLogger.LogInfoAsync(recordID, "CreateQuery Execution failed with the exception : " + ex.Message);
                }
            }

            
            return oQuery;
        }

        
        
    }
}
