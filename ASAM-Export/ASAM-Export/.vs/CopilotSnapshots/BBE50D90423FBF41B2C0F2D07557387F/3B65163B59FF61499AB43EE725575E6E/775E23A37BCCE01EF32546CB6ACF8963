        {
            var configMock = CreateMockConfig();
            return new RO_OSLC_DataInterface(
                "TESTSYS", "RO-ASAM-AUDI", "REC1",
                null,
                httpMock?.Object ?? new Mock<IHttpService>().Object,
                configMock.Object,
                fsMock?.Object ?? new Mock<IFileSystem>().Object);
        }

