        private const string AtomXml = @"<?xml version='1.0'?>
            <feed xmlns='http://www.w3.org/2005/Atom'>
                <entry>
                    <id>http://server/attach/1</id>
                    <content>
                        <attachment xmlns='http://www.ibm.com/xmlns/prod/rational/clearquest/1.0/'>
                            <filename>doc.pdf</filename>
