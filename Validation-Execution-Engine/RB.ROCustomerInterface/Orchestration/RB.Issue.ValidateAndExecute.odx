[Microsoft.XLANGs.BaseTypes.BPELExportable(false)]
module RB.ROCustomerInterface
{
    internal porttype ptUpdatedIMF
    {
        oneway opnSndUpdatedIMF
        {
            Schema.RB.ASAM.RB_RO_ASAM
        };
    };
    internal porttype ptIMF
    {
        oneway opnIMF
        {
            Schema.RB.ASAM.RB_RO_ASAM
        };
    };
    internal porttype ptExecutionFailed
    {
        oneway opnSendExecutionFailed
        {
            Schema.RB.ASAM.RB_RO_ASAM
        };
    };
    internal porttype prtIMFValidationFailed
    {
        oneway opnIMFValidationFailed
        {
            Schema.RB.ASAM.RB_RO_ASAM
        };
    };
    internal porttype prtIMFInterm
    {
        oneway oprnIMFInterm
        {
            Schema.RB.ASAM.RB_RO_ASAM
        };
    };
    internal porttype PTValidatedIMF
    {
        oneway oprnValidatedIMF
        {
            Schema.RB.ASAM.RB_RO_ASAM
        };
    };
    internal porttype PortType_Restarted
    {
        oneway opn_SndIMFRestarted
        {
            Schema.RB.ASAM.RB_RO_ASAM
        };
    };
    internal porttype opnSendAttForCompare
    {
        oneway Operation_1
        {
            Schema.AttachmentsBinaryCompare.BinaryComparison
        };
    };
    [Microsoft.XLANGs.BaseTypes.BPELExportable(false)]
    internal service IssueValidateAndExecute
    {
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port uses ptIMF pIMF;
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port uses prtIMFInterm pIMFInterm;
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port uses PTValidatedIMF pValidatedIMF;
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port uses ptExecutionFailed pExecutionFailed;
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port uses prtIMFValidationFailed pIMFValidationFailed;
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port uses PortType_Restarted pRestarted;
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port uses ptUpdatedIMF pUpdatedIMF;
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port uses opnSendAttForCompare pAttachments;
        message Schema.AttachmentsBinaryCompare.BinaryComparison msgSendAttachmentCompare;
        message Schema.AttachmentsBinaryCompare.BinaryComparison msgAttachmentCompare;
        message Schema.RB.ASAM.RB_RO_ASAM msgIMFAfterValidation;
        message Schema.RB.ASAM.RB_RO_ASAM msgUpdatedIMF;
        message Schema.RB.ASAM.RB_RO_ASAM msgSendIMF;
        message Schema.RB.ASAM.RB_RO_ASAM msgAfterRestart;
        System.String sIssueID;
        System.Int64 iListOfRestartedFiles;
        System.Int32 iListOfUnimportedAtt;
        System.String sFileNameWOExtn;
        body (RB.ROCustomerIntefaceLibrary.Logger Logger, System.String sInterfaceName, System.String sXProtID, message Schema.RB.ASAM.RB_RO_ASAM msgIMF, System.String sTargetProjectID, System.String sDownloadTargetPath, RB.ROCustomerIntefaceLibrary.BTHelper ROCustomerLibrary, ref System.Boolean isSuccess, System.String sIssueFileName, System.String sLifeToken, System.String sDownloadHost, System.String sSystem, System.String sFileNames, System.String sFirstFile, System.String sLastFile, System.Boolean isMsgAck)
        {
            sIssueID = "";
            iListOfUnimportedAtt = 0;
            sFileNameWOExtn = "";
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("ffba4d92-1f74-48a0-b9be-81b9e9928f09")]
            System.Diagnostics.EventLog.WriteEntry("ROINTERFACE","Validation Engine Starts" );
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("1b7f26f5-dec8-4aa7-abfd-2f9ddfa6fdc8")]
            construct msgSendIMF
            {
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("699e9dd3-78d1-454e-87c9-524f9c2edfc3")]
                transform (msgSendIMF) = RB.ROCustomerInterface.Map.IMFCopy (msgIMF);
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("06be15f3-7395-43a0-9a56-4ad5d2624399")]
                msgSendIMF = ROCustomerLibrary.PrettyXml(msgSendIMF,Logger);
                msgSendIMF(FILE.ReceivedFileName) = sDownloadHost + "_" + sXProtID +"_030_" + "IMF_Before_Validate"; 
                sInterfaceName = sInterfaceName;
                    
            }
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("2cd74589-6aac-437d-a722-40b9ab971a03")]
            send (pIMFInterm.oprnIMFInterm, msgSendIMF);
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("a1651ce6-ff5e-4163-a862-c462633df8cc")]
            if (ROCustomerLibrary.ValidateIMF(msgIMF,sInterfaceName,sDownloadTargetPath,sTargetProjectID,sXProtID,sIssueFileName,sLifeToken,sSystem,sFileNames,isMsgAck,Logger))
            {
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("f0dd9cd3-91e2-481b-91a4-bdaf2221c6fd")]
                System.Diagnostics.EventLog.WriteEntry("ROINTERFACE","Validation Successful");
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("80da62f7-e2a7-41ec-805a-51711d2eef19")]
                construct msgIMFAfterValidation
                {
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("f8f33254-9326-48ea-8aff-333eff1cd046")]
                    System.Diagnostics.EventLog.WriteEntry("ROINTERFACE","Getting ValidatedIMF" );
                    msgIMFAfterValidation=ROCustomerLibrary.GetModifiedIMF(sXProtID,Logger);
                    msgIMFAfterValidation(FILE.ReceivedFileName) = sDownloadHost + "_" + sXProtID +"_035_" + "IMF_After_Validate"; 
                    //System.Diagnostics.EventLog.WriteEntry("ROINTERFACE","After getting ValidatedIMF" );
                }
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("4ec6a12f-f9cb-463b-aa08-6304cc7712bd")]
                send (pValidatedIMF.oprnValidatedIMF, msgIMFAfterValidation);
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("e466ee16-186d-4fa7-b695-2daf48f8350a")]
                if (ROCustomerLibrary.Execute(msgIMF,sInterfaceName, sDownloadTargetPath, sTargetProjectID, sXProtID, sIssueFileName, sSystem, sFileNames, Logger))
                {
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("74377774-289d-4609-9b7e-e1ccc3037b34")]
                    System.Diagnostics.EventLog.WriteEntry("ROINTERFACE","Execution Successful. Issue Inserted / Updated into CQ" );
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("9ba39921-6807-485d-8602-1400a4ffc2f1")]
                    construct msgUpdatedIMF
                    {
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("35a840cb-363d-428d-8c2d-b9d7d591b2cc")]
                        System.Diagnostics.EventLog.WriteEntry("ROINTERFACE","Before getting updated IMF" );
                        msgUpdatedIMF=ROCustomerLibrary.GetModifiedIMF(sXProtID,Logger);
                        System.Diagnostics.EventLog.WriteEntry("ROINTERFACE","After getting updated IMF" );
                    }
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("b1e272b9-4898-42c0-9692-15fd80511bd4")]
                    if (msgUpdatedIMF!=null)
                    {
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("4a19586b-01c7-478f-9ca5-67ba793a772a")]
                        System.Diagnostics.EventLog.WriteEntry("ROINTERFACE","Updated IMF obtained from Isolated Storage Successfully" );
                        if(!isMsgAck)
                        {
                            sIssueID= ROCustomerLibrary.GetISSUEIDForBinCompare(msgUpdatedIMF,Logger);
                        }
                        else
                        {
                            sIssueID="";
                           
                        }
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("58329829-c09a-44d9-841c-6555f29a4c36")]
                        isSuccess = true;
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("58bb0da7-4e78-42ed-b4c0-1f68efd2a14f")]
                        construct msgSendIMF
                        {
                            [Microsoft.XLANGs.BaseTypes.DesignerPosition("dd1ca4c7-f9cf-424b-bdc1-b25a45550128")]
                            transform (msgSendIMF) = RB.ROCustomerInterface.Map.IMFCopy (msgUpdatedIMF);
                            [Microsoft.XLANGs.BaseTypes.DesignerPosition("9e3feec1-65a4-4628-aee1-c047e53923cd")]
                            msgSendIMF = ROCustomerLibrary.PrettyXml(msgSendIMF,Logger);
                            msgSendIMF(FILE.ReceivedFileName) = sDownloadHost + "_" + sXProtID +"_070_" + "IMF_Updated"; 
                        }
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("2ca142bd-b573-46ba-86be-8dcd2a16cac1")]
                        send (pUpdatedIMF.opnSndUpdatedIMF, msgSendIMF);
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("0795b5a6-a5f7-4034-a118-d2c13bacca6c")]
                        System.Diagnostics.EventLog.WriteEntry("ROINTERFACE","Execution succeeded-check for IMFRESET" );
                    }
                    else 
                    {
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("e6953134-02ac-4021-9a9b-4a2346f33be6")]
                        System.Diagnostics.EventLog.WriteEntry("ROINTERFACE","Updated IMF obtained from Isolated Storage Failed" );
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("f08c20c1-7b1a-429a-be5d-fef4ab58858c")]
                        isSuccess = true;
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("27700e24-4a53-4550-b81f-694d68ca8ff1")]
                        construct msgSendIMF
                        {
                            [Microsoft.XLANGs.BaseTypes.DesignerPosition("c5203fcf-315b-4ed2-8527-2bf174ee24d7")]
                            transform (msgSendIMF) = RB.ROCustomerInterface.Map.IMFCopy (msgIMF);
                            [Microsoft.XLANGs.BaseTypes.DesignerPosition("87255c43-7056-4db0-a8e0-44dd1ad5e059")]
                            msgSendIMF(FILE.ReceivedFileName) = sDownloadHost + "_" + sXProtID +"_060_" + "IMF_Before_Update"; 
                        }
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("c4b0d58e-ba23-4862-948e-0965d45f9e7c")]
                        send (pIMF.opnIMF, msgUpdatedIMF);
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("dfbea704-362a-443e-88d5-6bf068cd2130")]
                        System.Diagnostics.EventLog.WriteEntry("ROINTERFACE","Execution succeeded-IMFUPDATED not found-check for IMFRESET" );
                    }
                }
                else 
                {
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("34d9b280-ff7b-4f5e-a7cb-1eb8db3a3ef5")]
                    System.Diagnostics.EventLog.WriteEntry("ROINTERFACE","Execution failed. Check log file for error messages" );
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("103adba3-e85f-4a4f-a37e-faf0d8c7447b")]
                    isSuccess = false;
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("6d97af3a-eca5-4403-988e-109a24820a41")]
                    construct msgSendIMF
                    {
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("cb642c1e-5794-441f-bf0b-f389d6bcedf1")]
                        transform (msgSendIMF) = RB.ROCustomerInterface.Map.IMFCopy (msgIMF);
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("210612cf-363f-4006-8cd2-bf61cf9965f5")]
                        msgSendIMF = ROCustomerLibrary.PrettyXml(msgSendIMF,Logger);
                        msgSendIMF(FILE.ReceivedFileName) = sDownloadHost + "_" + sXProtID +"_050_" + "IMF_Execution_Failed"; 
                    }
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("9a461c21-0e38-42c5-843d-75557e4d63c3")]
                    send (pExecutionFailed.opnSendExecutionFailed, msgSendIMF);
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("1ade77d9-f849-47e7-94d3-c5ef719e1121")]
                    System.Diagnostics.EventLog.WriteEntry("ROINTERFACE","Execution failed- check for IMFRESET" );
                }
            }
            else 
            {
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("e4335819-4bf4-4e57-856d-b22a5f7ac5c5")]
                System.Diagnostics.EventLog.WriteEntry("ROINTERFACE","Validation failed. Check log file for error messages" );
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("5859bb8c-84c6-43c8-974b-083c0299b25d")]
                isSuccess = false;
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("8d00343f-0060-4553-bd67-38bb06bef875")]
                construct msgSendIMF
                {
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("7704d6ee-997c-48f3-a24f-2f507bd01820")]
                    transform (msgSendIMF) = RB.ROCustomerInterface.Map.IMFCopy (msgIMF);
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("16a2fb3f-15e7-47a1-b705-83fc1e477869")]
                    msgSendIMF = ROCustomerLibrary.PrettyXml(msgSendIMF,Logger);
                    msgSendIMF(FILE.ReceivedFileName) = sDownloadHost + "_" + sXProtID +"_040_" + "IMF_RulesValidation_Failed"; 
                }
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("8f95360d-ca6b-4187-b574-bcb8b352f62f")]
                send (pIMFValidationFailed.opnIMFValidationFailed, msgSendIMF);
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("bc904590-8458-42b2-a79b-2ded8bdc853c")]
                System.Diagnostics.EventLog.WriteEntry("ROINTERFACE","Validation failed-check for IMFRESET" );
            }
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("28cd2280-ecff-4f25-ac85-9b69f863c059")]
            
            System.Diagnostics.EventLog.WriteEntry("ROINTERFACE","sIssueID="+sIssueID);
            if(sIssueID != "")
            {
            System.Diagnostics.EventLog.WriteEntry("ROINTERFACE","GetattFilesCount starts" );
            
            
            iListOfUnimportedAtt = ROCustomerLibrary.GetUnimportedAttCount(sIssueID,Logger);
            System.Diagnostics.EventLog.WriteEntry("ROINTERFACE","No of UnimportedAtt files = "+ iListOfUnimportedAtt.ToString());
            }
            else
            {
            iListOfUnimportedAtt=0;
            }
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("f9a31764-db11-4451-91ce-0e3614138eb9")]
            while (iListOfUnimportedAtt > 0)
            {
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("d398ae0d-78ee-4dfc-b5b7-4c2d8fdc26cb")]
                construct msgAttachmentCompare
                {
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("5797237e-a4d7-4523-8e5d-422174e27448")]
                    System.Diagnostics.EventLog.WriteEntry("ROINTERFACE","Before getting IMF att file" );
                    msgAttachmentCompare = ROCustomerLibrary.GetUnImportedAttXML(sIssueID,iListOfUnimportedAtt,Logger);
                    msgAttachmentCompare = ROCustomerLibrary.AddMissingparams(msgAttachmentCompare,sXProtID,
                    sSystem,sDownloadTargetPath,sInterfaceName,sIssueFileName,Logger);
                    
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("064bc0c6-c2b6-426f-9f47-135a1f9683ab")]
                    System.Diagnostics.EventLog.WriteEntry("ROINTERFACE"," after add param" );
                    sFileNameWOExtn = ROCustomerLibrary.GetFileNameWithoutExtn(sIssueFileName,Logger);
                    msgAttachmentCompare(FILE.ReceivedFileName)=sXProtID+"_"+sIssueID+"_"+sFileNameWOExtn;
                    System.Diagnostics.EventLog.WriteEntry("ROINTERFACE","aft getting att xml file");
                }
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("e02551d7-e0bc-4a7a-8d57-a4ef400f8402")]
                send (pAttachments.Operation_1, msgAttachmentCompare);
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("c48a8fbb-0d15-49f2-b5e7-b72311011b4b")]
                System.Diagnostics.EventLog.WriteEntry("ROINTERFACE","Decrementing of iListOfRestartedFiles" );
                iListOfUnimportedAtt = iListOfUnimportedAtt-1;
            }
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("6806fb9f-2daa-40dc-b56b-ffc74651d3d9")]
            if(!isMsgAck)
            {
                System.Diagnostics.EventLog.WriteEntry("ROINTERFACE","GetRestartedFilesCount starts" );
                iListOfRestartedFiles = ROCustomerLibrary.GetRestartedFilesCount(sXProtID);
                System.Diagnostics.EventLog.WriteEntry("ROINTERFACE","No of restarted files = "+iListOfRestartedFiles.ToString());
                //System.Diagnostics.EventLog.WriteEntry("ROINTERFACE","GetRestartedFilesCount ends" );
            }
            else
            {
                iListOfRestartedFiles=0;
            }
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("ad0e7143-d021-4d6a-a0df-b227bf17e39f")]
            while (iListOfRestartedFiles > 0)
            {
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("76ad9a87-b1cd-4161-b60c-b71607051b33")]
                construct msgAfterRestart
                {
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("1ca13fea-0f0e-4422-9d3f-0bfef3fe0724")]
                    System.Diagnostics.EventLog.WriteEntry("ROINTERFACE","Before getting IMF Restarted file" );
                    msgAfterRestart=ROCustomerLibrary.GetRestartedIMF(sXProtID);
                    System.Diagnostics.EventLog.WriteEntry("ROINTERFACE","After getting Imf Restarted file" );
                }
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("d6ae1b10-0973-4134-b524-feecf069e4ff")]
                construct msgSendIMF
                {
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("3627fb9e-9cae-44b7-a240-8e8b95452bf6")]
                    transform (msgSendIMF) = RB.ROCustomerInterface.Map.IMFCopy (msgAfterRestart);
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("3b7fd02c-7731-481a-a66b-14535bdbc636")]
                    msgSendIMF(FILE.ReceivedFileName) = sDownloadHost + "_" + sXProtID +"_045_"+ "IMF_AfterRestart"; 
                    System.Diagnostics.EventLog.WriteEntry("ROINTERFACE","Send Restarted file" );
                }
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("d298ec25-c044-429f-a963-b6fad0f38f28")]
                send (pRestarted.opn_SndIMFRestarted, msgSendIMF);
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("3dff06e7-3b0f-4633-8e3f-a7b0fc409ee5")]
                System.Diagnostics.EventLog.WriteEntry("ROINTERFACE","Decrementing of iListOfRestartedFiles" );
                iListOfRestartedFiles = iListOfRestartedFiles-1;
            }
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("c68b9e4e-cbab-4e22-a207-c5f6b9639091")]
            System.Diagnostics.EventLog.WriteEntry("ROINTERFACE","ClearIsoStoreReset starts" );
            ROCustomerLibrary.ClearIsoStoreReset(sXProtID);
            System.Diagnostics.EventLog.WriteEntry("ROINTERFACE","ClearIsoStoreReset ends" );
        }
    }
}

