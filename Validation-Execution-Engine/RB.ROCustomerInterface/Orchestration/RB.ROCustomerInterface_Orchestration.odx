                                                                        "No_Valid_XML_Present";
                                                                        
                            }
                            [Microsoft.XLANGs.BaseTypes.DesignerPosition("4a6f883f-b0e2-4019-b691-e8d00acf17b1")]
                            System.Diagnostics.EventLog.WriteEntry("ROINTERFACE","Writing Log info to Exchange Protocol for File not found starts" );
                            
                            ROCustomerLibrary.WriteUserInformation(sExchangeProtocolID,sLifeTokenXPort,true,sInterfaceName,sSystem,true,false,sXPROTInitalLog, ROLogger);
                            
                            
                            [Microsoft.XLANGs.BaseTypes.DesignerPosition("fae5cb58-74c9-48e9-b80c-a9263dd0cdc0")]
                            send (SendInvalidIssueFileName.InvalidOrNoFile, msgFileSend);
                        }
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("c3d6d547-4e7b-41a0-aa8f-a229e22b6d25")]
                        System.Diagnostics.EventLog.WriteEntry("ROINTERFACE","Writing Log info to Exchange Protocol finally - Starts" );
                        //ROCustomerLibrary.WriteUserInformation(sExchangeProtocolID,sLifeTokenXPort,true,sInterfaceName,sSystem);
                        ROCustomerLibrary.WriteUserInformation(sExchangeProtocolID,sLifeTokenXPort,true,sInterfaceName,sSystem,false,false, sXPROTInitalLog, ROLogger);
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("d2d2a675-1c39-4781-b85b-996f0837ce90")]
                        construct msgImportResult
                        {
                            [Microsoft.XLANGs.BaseTypes.DesignerPosition("dc68f40c-7291-4cab-8825-16bcd01d955c")]
                            msgImportResult = msgFTPTransfer;
                            
                            msgImportResult.LifeToken4XProt = "tbd";
                            msgImportResult.LifeToken4Files = sLifeTokenXPort;
                            
                            msgImportResult(FILE.ReceivedFileName) = sDownloadHost + "_" + sExchangeProtocolID +"_090_" + "FTPFileShift"; 
                            
                        }
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("aa72b0aa-5c0a-4627-a669-05d18757aeee")]
                        send (SendResultPort.Operation_1, msgImportResult);
                    }
                    else 
                    {
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("55421618-fa3e-47b8-bc56-5c188e21d0b7")]
                        
                        ROCustomerLibrary.AddXProtForLogger(sExchangeProtocolID,ROLogger);
                        
                        ROLogger.LogInfo("LifeToken4Xprot = Delete");
                        ROLogger.LogInfo("Calling DeregisterFiles");
                        System.Diagnostics.EventLog.WriteEntry("ROINTERFACE","LifeToken4Xprot = Delete, Calling DeregisterFiles");
                        
                        ROCustomerLibrary.DeregisterFiles(sExchangeProtocolID,ROLogger);
                        //System.Diagnostics.EventLog.WriteEntry("ROINTERFACE","After calling DeregisterFiles");
                    }
                }
                exceptions
                {
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("55aa476c-96e0-4c7a-b419-03f0a76c0a4a")]
                    catch (System.SystemException Exception)
                    {
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("ef0cd6d0-bec7-4a45-897d-73bf2d7e0a5c")]
                        sLifeTokenXPort = "::Failure,Exception in Importing ASAM file: "+Exception.Message.ToString();
                        
                        //call degrister and clear all files in static table
                        ROCustomerLibrary.DeregisterFiles(sExchangeProtocolID,ROLogger);
                        
                        ROCustomerLibrary.WriteUserInformation(sExchangeProtocolID,sLifeTokenXPort,true,sInterfaceName,sSystem,true,false,sXPROTInitalLog, ROLogger);
                    }
                }
            }
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("2095b58a-10c2-45b1-a63d-a67c2f78a4a0")]
            System.Diagnostics.EventLog.WriteEntry("ROINTERFACE","Interface run completed" );
        }
    }
}

