                                        if(sLifeTokenTemp != System.String.Empty)
                                        {
                                            sLifeTokenXPort = sLifeTokenTemp;
                                        }
                                        //Get the index of "In Progress" string in the lifetoken string and build the failure error
                                        indexOfInProgress = sLifeTokenXPort.IndexOf(sIssueFileName) + sIssueFileName.Length + 2;//Length of "::" is 2
                                        if(indexOfInProgress != -1)
                                        {
                                            sLifeTokenXProtBuilder.Append(sLifeTokenXPort, 0, sLifeTokenXPort.Length);
                                            sLifeTokenXProtBuilder.Remove(indexOfInProgress, 11); //Length of "In Progress" is 11
                                            sLifeTokenXProtBuilder.Insert(indexOfInProgress, "Failure >>Error - CQUSER<<||E: Error in identifying ISSUE-STATE and CATEGORY. Please recheck ASAM file");
                                            sLifeTokenXPort = sLifeTokenXProtBuilder.ToString();
                                        }
