    [Microsoft.XLANGs.BaseTypes.BPELExportable(false)]
    public service RO_CustomerInterface
    {
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port implements ftpTrnsRecPortType ftpTransferRecPort;
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port uses prtInvalidOrNoFile SendInvalidIssueFileName;
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port uses PortType_1 SendResultPort;
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port uses PtSingleFileImport sndSingleFileImportResult;
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port uses PtShiftSingleFileImport sndSingleFileShift;
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port uses PortType_SingleFileUpdate sndSingleFileUpdate;
        message Schema.Transfer.TransferResultInformation msgImportSingleFileUpdate;
        message Schema.Transfer.SingleFileTransferResultOld msgImportSingleFile_Copy;
        message Schema.Transfer.TransferResultInformation msgImportResult_Copy;
        message Schema.RB.ASAM.RB_RO_ASAM msgIMFCopy;
        message Schema.Transfer.TransferResultInformation msgFTPTransfer;
        message Schema.RB.ASAM.RB_RO_ASAM msgIMF;
        message Schema.ASAM.issue_v3_0_0_sl msgIssue;
        message Schema.RB.ASAM.RB_RO_ASAM msgUpdatedIMF;
        message Schema.BMW.ASAM_ISSUE_V3_0_1_proposed msgBMW;
        message System.String msgFileName;
        message Schema.Transfer.TransferResultInformation msgFileSend;
        message Schema.BMW.issue_v3_1_0_sl msgBMW310;
        message System.Xml.XmlDocument msgValidateSchema;
        message Schema.Transfer.TransferResultInformation msgImportResult;
        message Schema.Transfer.SingleFileTransferResultOld msgImportSingleFile;
        message Schema.RB.ASAM.RB_RO_ASAM msgIMFHISMappingOut;
        System.String sStatusForSingleFile;
        System.Int64 iTotalfileCount;
        RB.ROCustomerIntefaceLibrary.BTHelper ROCustomerLibrary;
        System.Int64 iListOfIssueFiles;
        System.String sIssueFileName;
        System.Boolean isSuccess;
        System.String sExchangeProtocolID;
        System.String sInterfaceName;
        System.String sDownloadTargetPath;
        System.String sTargetProjectID;
        System.String sLifeTokenXPort;
        System.String sDownloadHost;
        System.String sLifeTokenTemp;
        System.String sIssueCategory;
        System.String sIssueState;
        System.String sIssueFileNames;
        System.String sSystem;
        System.Type oMap;
        System.String sMapName;
        System.String sTokenForSingleFile;
        RB.ROCustomerIntefaceLibrary.Logger ROLogger;
        System.String sIssueFileNamesCopy;
        System.String FirstFile;
        System.String LastFile;
        System.String sXPROTInitalLog;
        System.String sNameWOExtn;
        System.String sConfigPath;
        System.Boolean bHISMapping;
        System.String sFTPStatus;
        System.String sTransactionID;
        System.String sDownloadPathAI;
        System.String sMode;
        System.String sLifeToken4XPROT;
        System.Boolean isMsgAck;
        System.String sFilterRegex;
        System.Int32 indexOfInProgress;
        System.Text.StringBuilder sLifeTokenXProtBuilder;
        System.String sCategory;
        body ()
        {
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("f1afcb53-5008-4664-b6c4-5c6ac060c3b7")]
            activate receive (ftpTransferRecPort.oprnGetFTPTrans, msgFTPTransfer);
            sStatusForSingleFile = "";
            ROCustomerLibrary = new RB.ROCustomerIntefaceLibrary.BTHelper();
            sIssueFileName = "";
            isSuccess = false;
            sExchangeProtocolID = "";
            sInterfaceName = "";
            sDownloadTargetPath = "";
            sTargetProjectID = "";
            sLifeTokenXPort = "";
            sDownloadHost = "";
            sLifeTokenTemp = "";
            sIssueCategory = "";
            sIssueState = "";
            sIssueFileNames = "";
            sSystem = "";
            sMapName = "";
            sTokenForSingleFile = "";
            sIssueFileNamesCopy = "";
            FirstFile = "";
            LastFile = "";
            sXPROTInitalLog = "";
            sNameWOExtn = "";
            sConfigPath = "";
            bHISMapping = true;
            sFTPStatus = "";
            sTransactionID = "";
            sDownloadPathAI = "";
            sMode = "";
            sLifeToken4XPROT = "";
            isMsgAck = false;
            sFilterRegex = "";
            sLifeTokenXProtBuilder = new System.Text.StringBuilder();
            sCategory = "";
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("5ff2ad40-0ab5-4bb7-a84c-b04484b39e44")]
            System.Diagnostics.EventLog.WriteEntry("ROINTERFACE","Interface run starts" );
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("49bff2c1-4d61-40cc-9341-649fb7486df5")]
            System.Diagnostics.EventLog.WriteEntry("ROINTERFACE","Setting Variables starts" );
            
            sInterfaceName = msgFTPTransfer.InterfaceName;
            sDownloadTargetPath=msgFTPTransfer.DownloadTargetPath;
            //sTargetProjectID=msgFTPTransfer.TargetProjectID; REUBK-2191(Target Project is file specific)
            sExchangeProtocolID = msgFTPTransfer.XProtID;
            sSystem = msgFTPTransfer.RQ1System;
            sLifeTokenXPort = msgFTPTransfer.LifeToken4Files;
            sLifeToken4XPROT = msgFTPTransfer.LifeToken4XProt;
            
            sMode = msgFTPTransfer.Mode;
            
            
            
            System.Diagnostics.EventLog.WriteEntry("ROINTERFACE","Interface name ="+ sInterfaceName);
            //System.Diagnostics.EventLog.WriteEntry("ROINTERFACE","Setting Variables ends" );
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("f3c8a27c-08ce-4ab0-a25c-3c5f5f78cea7")]
            sConfigPath = ROCustomerLibrary.GetConfigPathForLogger(sInterfaceName,sExchangeProtocolID);
            System.Diagnostics.EventLog.WriteEntry("ROINTERFACE","sConfigPath="+sConfigPath);
            ROLogger = new RB.ROCustomerIntefaceLibrary.Logger(sConfigPath);
            
            ROCustomerLibrary.SetLoggingMode(sInterfaceName,ROLogger);
            
            ROLogger.LogInfo("Log set");
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("51a4ff52-94bb-4b22-8b62-0151d380ead1")]
            scope
            {
                body
                {
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("37d6db9d-89dd-40ac-86ba-dffce67d9ff4")]
                    if (sLifeToken4XPROT != "Delete")
                    {
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("c4588d4e-c7d5-4029-80fd-3e1c49abf211")]
                        
                        System.Diagnostics.EventLog.WriteEntry("ROINTERFACE","Getting Files count from input path - " +msgFTPTransfer.DownloadTargetPath );
                        sDownloadPathAI = sDownloadTargetPath;
                        if(sMode.ToUpper() == "AUTOMATIC")
                        {
                            sDownloadTargetPath = ROCustomerLibrary.GetAIFilesLocation(sDownloadTargetPath);
                        }
                        
