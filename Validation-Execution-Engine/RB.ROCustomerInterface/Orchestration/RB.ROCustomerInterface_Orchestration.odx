                        System.Diagnostics.EventLog.WriteEntry("ROINTERFACE","Setting the ExchangeProtocol Id ends");
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("184c7ef9-a72f-4832-b68d-14345639222b")]
                        if (iListOfIssueFiles > 0)
                        {
                            [Microsoft.XLANGs.BaseTypes.DesignerPosition("1441b573-b19e-4107-80ef-c6e92075ee98")]
                            sLifeTokenXPort = msgFTPTransfer.LifeToken4Files;
                            
                            sDownloadHost = msgFTPTransfer.RQ1System;
                            sDownloadHost = sDownloadHost.Substring(sDownloadHost.LastIndexOf("@")+1);
                            
                            System.Diagnostics.EventLog.WriteEntry("ROINTERFACE","iListOfIssueFiles is: " + iListOfIssueFiles.ToString() + "Processing file starts" );
