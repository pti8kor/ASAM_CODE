                                        bHISMapping = true;
                                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("315ee685-a735-4503-a9ef-67e7af092041")]
                                        if (sIssueCategory.ToUpper() == "HARDWARE" && sIssueState.ToUpper() == "REQUESTED" && sInterfaceName.ToUpper() == "RO-ASAM-AUDI")
                                        {
                                            [Microsoft.XLANGs.BaseTypes.DesignerPosition("68b0acc0-c95e-4a24-96e5-ada1d1a88eb5")]
