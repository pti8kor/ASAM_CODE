[Microsoft.XLANGs.BaseTypes.BPELExportable(false)]
module RB.ROCustomerInterface
{
    internal porttype PortType_FTPTransferResultUpdate
    {
        oneway Operation_1
        {
            Schema.Transfer.TransferResultInformation
        };
    };
    internal porttype PortType_sndRestartXPROT
    {
        oneway Operation_1
        {
            Schema.Transfer.TransferResultInformation
        };
    };
    [Microsoft.XLANGs.BaseTypes.BPELExportable(false)]
    internal service Orchestration_1
    {
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port implements PortType_FTPTransferResultUpdate FTPTransferResultUpdate;
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port uses PortType_sndRestartXPROT sndXPROTRestart;
        message Schema.Transfer.TransferResultInformation msgFTPResultUpdate;
        message Schema.Transfer.TransferResultInformation msgFTPResultUpdateNew;
        System.String sExchangeProtocolID;
        RB.ROCustomerIntefaceLibrary.Logger ROLogger;
        RB.ROCustomerIntefaceLibrary.BTHelper ROCustomerLibrary;
        System.String sConfigPath;
        System.String sInterfaceName;
        System.String sXPROTInitalLog;
        System.String sSystem;
        body ()
        {
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("a07477f7-c804-40bf-accb-d159bdf5cbfe")]
            activate receive (FTPTransferResultUpdate.Operation_1, msgFTPResultUpdate);
            sExchangeProtocolID = "";
            ROCustomerLibrary = new RB.ROCustomerIntefaceLibrary.BTHelper();
            sConfigPath = "";
            sInterfaceName = "";
            sXPROTInitalLog = "";
            sSystem = "";
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("4b3d501b-77a7-454a-b1b7-1a319c058cfa")]
            System.Diagnostics.EventLog.WriteEntry("ROINTERFACE-RestartXPROT","XPROT-Restart starts" );
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("316f4bf7-2070-4d01-bbac-e75a28a25bed")]
            System.Diagnostics.EventLog.WriteEntry("ROINTERFACE-RestartXPROT","Setting Variables starts" );
            
            sInterfaceName = msgFTPResultUpdate.InterfaceName;
            sExchangeProtocolID = msgFTPResultUpdate.XProtID;
            sSystem = msgFTPResultUpdate.RQ1System;
            System.Diagnostics.EventLog.WriteEntry("ROINTERFACE-RestartXPROT","Interface name ="+ sInterfaceName);
            System.Diagnostics.EventLog.WriteEntry("ROINTERFACE-RestartXPROT","Setting Variables ends" );
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("3720ec74-62c2-4450-a4f3-5ed827fd977f")]
            sConfigPath = ROCustomerLibrary.GetConfigPathForLogger(sInterfaceName,sExchangeProtocolID);
            ROLogger = new RB.ROCustomerIntefaceLibrary.Logger(sConfigPath);
            System.Diagnostics.EventLog.WriteEntry("ROINTERFACE-RestartXPROT","sConfigPath="+sConfigPath);
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("4b07f997-0458-44bc-9a71-b107dd9c8f7e")]
            System.Diagnostics.EventLog.WriteEntry("ROINTERFACE-RestartXPROT","Setting the ExchangeProtocol Id starts");
            
            //Set the value in internal store for accessing in MAP
            ROCustomerLibrary.AddXProtForLogger(sExchangeProtocolID,ROLogger);
            
            System.Diagnostics.EventLog.WriteEntry("ROINTERFACE-RestartXPROT","Setting the ExchangeProtocol Id ends");
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("f8aa4494-f1c9-47cb-9e64-add526f6d62f")]
            System.Diagnostics.EventLog.WriteEntry("ROINTERFACE-RestartXPROT","callUnlockRecord");
            System.Diagnostics.EventLog.WriteEntry("ROINTERFACE-RestartXPROT","sSystem="+sSystem);
            ROCustomerLibrary.UnlockRecord(sExchangeProtocolID,sInterfaceName,sSystem,ROLogger);
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("58d04e54-46eb-4a84-90b0-f40de64787b4")]
            System.Diagnostics.EventLog.WriteEntry("ROINTERFACE-RestartXPROT","UpdateXPROTLog");
            sXPROTInitalLog = ROCustomerLibrary.GetInitialValueofXprot(sExchangeProtocolID,sInterfaceName,sSystem,ROLogger);
            ROCustomerLibrary.UpdateXPROTLog(sExchangeProtocolID,sXPROTInitalLog,sInterfaceName,sSystem,ROLogger);
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("c45c3655-b69b-4ab7-b07e-4bcc5e0c7421")]
            construct msgFTPResultUpdateNew
            {
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("569b93a2-119b-44e7-b322-849d88d1cc62")]
                msgFTPResultUpdateNew = msgFTPResultUpdate;
                //msgFTPResultUpdateNew = ROCustomerLibrary.SetNewLifeTokenForTransferResult(msgFTPResultUpdateNew,ROLogger);
                System.Diagnostics.EventLog.WriteEntry("ROINTERFACE-RestartXPROT","send to valin");
            }
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("dadc21d3-6d42-4565-aa9c-60186d397f22")]
            send (sndXPROTRestart.Operation_1, msgFTPResultUpdate);
        }
    }
}

