        public override IQueryResult Query(QueryParameters p_oQueryParameters, bool bLoopQueryResults = false, XElement xROIDRule = null, string ExchangeProtocol = null)
        {

            objlogger.LogInfo("OSLC Query : starts", GlobalConstants.LOGGERLEVEL1);

            OSLC_QueryResult l_oQueryResult = new OSLC_QueryResult();
            try
            {
                sQuery = null;

                if (!p_oQueryParameters.IsComplex)
                {
                    foreach (var l_oParameter in p_oQueryParameters.GetRaw())
                    {
                        if (l_oParameter.Key != GlobalConstants.RECORDTYPE)
                            BuildQuery(l_oParameter.Key, l_oParameter.Value, null);
                        else
                            BuildQuery(l_oParameter.Key, null, l_oParameter.Value);
                    }

                    objlogger.LogInfo("OSLC Query as follows :" + sQuery.ToString(), GlobalConstants.LOGGERLEVEL1);

                    XDocument xDoc = ExecuteOSLCQuery(sQuery.ToString(), false);

                    l_oQueryResult.SetRaw(xDoc);
                }
                else
                {
                    XDocument xDoc = p_oQueryParameters.GetRawComplex()
                                     .Where(n => n.Key == OSLCComplexType.MAINRECORD)
                                     .Select(n => n.Value).Single() as XDocument;


                    if (xDoc == null) return null;

                    objlogger.LogInfo("xdoc:" + xDoc.ToString(), GlobalConstants.LOGGERLEVEL2);
                    //objlogger.LogInfo(xDoc.ToString());
                    XDocument xResponse = GetLinkedRecord(xDoc,bLoopQueryResults,xROIDRule);

                    if (xResponse != null) //REUBK-3603
                    {
                        WriteRQ1IntoXMl(xResponse, ExchangeProtocol);
                        objlogger.LogInfo("Set raw", GlobalConstants.LOGGERLEVEL2);
                        l_oQueryResult.SetRaw(xResponse);

                    }

                    //REUBK-3603
                    if (bLoopQueryResults)
                    {
                        //objlogger.LogInfo("Calling GetAllLinkedRecordDbids");
                        l_oQueryResult.ReturnedDbids = GetAllLinkedRecordDbids(xDoc, xROIDRule);
                    }
                }
            }
            catch (System.Net.WebException exp)
            {
                objlogger.LogException(exp, "OSLC Query WebException");
                throw;
            }
            catch (Exception ex)
            {
                objlogger.LogException(ex, "OSLC Query");
                throw;
            }

            //objlogger.LogInfo("OSLC Query : ends");

            l_oQueryResult.DataInterface = this;
            objlogger.LogInfo("OSLC Query : ends - checking rec count : " + l_oQueryResult.RecordCount, GlobalConstants.LOGGERLEVEL1);
            return l_oQueryResult;
        }

