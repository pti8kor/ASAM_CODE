        public XDocument InvokeURL(string sUrlToInvoke)
        {
            objlogger.LogInfo("ClearQuest::InvokeURL : Starts with URL:\n" +
                sUrlToInvoke, GlobalConstants.LOGGERLEVEL1);
            XDocument xDoc = null;
            try
            {
                ServicePointManager.Expect100Continue = true;
                ServicePointManager.SecurityProtocol = SecurityProtocolType.Tls
                       | SecurityProtocolType.Tls11
                       | SecurityProtocolType.Tls12
                       | SecurityProtocolType.Ssl3;
                HttpWebRequest httpWebReq = WebRequest.Create(sUrlToInvoke) as HttpWebRequest;
                httpWebReq.Credentials = new NetworkCredential(CQUser, CQPasword);
                httpWebReq.CookieContainer = l_oSessionCookie;
                string sRequesterInfo = "toolname=" + CQToolName + ";toolversion=" + CQToolVersion + ";user=" + "bt9rsi";
                if (!string.IsNullOrEmpty(CQToolTesting) && CQToolTesting.ToUpper() == "TRUE")
                {
                    sRequesterInfo = sRequesterInfo + ";toolTesting=" + CQToolTesting;
                }
                // WI 282232 - Extend OSLC Requests with additional Header for access control of RQ1
                httpWebReq.Headers.Add("OSLC-Core-Version", "1.0");
                httpWebReq.Headers.Add("x-requester", sRequesterInfo);
                
                using (HttpWebResponse resp = httpWebReq.GetResponse() as HttpWebResponse)
                {
                    using (StreamReader reader = new StreamReader(resp.GetResponseStream()))
                    {
                        xDoc = XDocument.Load(reader);
                    }

                    try
                    {
                        //Handling for  oslc result count > oslc max page size
                        XElement xLinkNext = xDoc.Root.Elements(XName.Get("link", nsAtom.ToString())).Where(s => s.Attribute("rel").Value == "next").Single();
                        if (xLinkNext != null)
                        {
                            string nextUrl = xLinkNext.Attribute("href").Value;
                            XDocument xNext = InvokeURL(nextUrl);
                            foreach (XElement xe in xNext.Root.Elements(XName.Get("entry", nsAtom.ToString())))
                                xDoc.Root.Add(xe);
                        }
                    }
                    catch (Exception)
                    { }
                }

            }
            catch (System.Net.WebException exp)
            {
                objlogger.LogException(exp, "ClearQuest::InvokeURLWebException");
                // xDoc = XDocument.Load(GlobalConstants.OSLC_DUMMY_XML); REUBK-1610
                throw;
            }
            catch (Exception ex)
            {
                objlogger.LogException(ex, "ClearQuest::InvokeURLException");
                //Set dummy XML
                // xDoc = XDocument.Load(GlobalConstants.OSLC_DUMMY_XML);
                throw;
            }
            objlogger.LogInfo("ClearQuest::InvokeURL : ends", GlobalConstants.LOGGERLEVEL1);
            objlogger.LogInfo("ClearQuest::InvokeURL ends :" + xDoc.ToString(), GlobalConstants.LOGGERLEVEL2);

            

            return xDoc;
        }

        /// <summary>
        /// Method to Save (Issue, Release, IRMAP) Target values Before Execution -- This implementaion is because of implementation of hiding  data in RQ1
        /// </summary>
        /// <param name="xdoc"></param>
        /// <param name="Excahange_Protocol"></param>
        public void WriteRQ1IntoXMl(XDocument xdoc, string Excahange_Protocol)
        {
            XmlWriterSettings settings = new XmlWriterSettings();
            settings.OmitXmlDeclaration = true;
            settings.Indent = true;

            string destionationPath = @"D:\ASAM-IF-IMPORT\Import\050 - BTMessages\";

            try
            {
                if(!String.IsNullOrEmpty(Excahange_Protocol))
                {
                    if (((System.Xml.Linq.XElement)((System.Xml.Linq.XContainer)xdoc.FirstNode).FirstNode).Value.ToString().ToLower() == "release")
                    {
                        string releaseID = string.Empty;
                        foreach (XNode node in xdoc.Root.Nodes())
                        {
                            if (node.ToString().Contains("dc:title"))
                            {
                                releaseID = ((System.Xml.Linq.XElement)node).Value;
                                break;
                            }

                        }

                        using (var stream = File.Create(destionationPath + "RQONE_" + Excahange_Protocol + "_" + releaseID + "_038_ReleaseTargetValues_Before_Execution.xml"))
                        {

                            using (var writer = XmlWriter.Create(stream, settings))
                            {
                                xdoc.Save(writer);
                                objlogger.LogInfo("Release Target Values Saved Successfully Before Execution");
                            }
                        }

                    }

                    else if (((System.Xml.Linq.XElement)((System.Xml.Linq.XContainer)xdoc.FirstNode).FirstNode).Value.ToString().ToLower() == "issue")
                    {
                        string issueID = string.Empty;
                        foreach (XNode node in xdoc.Root.Nodes())
                        {
                            if (node.ToString().Contains("dc:title"))
                            {
                                issueID = ((System.Xml.Linq.XElement)node).Value;
                                break;
                            }

                        }
                        using (var stream = File.Create(destionationPath + "RQONE_"+Excahange_Protocol + "_" + issueID + "_038_IssueTargetValues_Before_Execution.xml"))
                        {

                            using (var writer = XmlWriter.Create(stream, settings))
                            {
                                xdoc.Save(writer);
                                objlogger.LogInfo("Issue Target Values Saved Successfully Before Execution");
                            }
                        }

                    }

                    else if (((System.Xml.Linq.XElement)((System.Xml.Linq.XContainer)xdoc.FirstNode).FirstNode).Value.ToString().ToLower() == "issuereleasemap")
                    {
                        string issuereleasemapID = string.Empty;
                        foreach (XNode node in xdoc.Root.Nodes())
                        {
                            if (node.ToString().Contains("dc:title"))
                            {
                                issuereleasemapID = ((System.Xml.Linq.XElement)node).Value;
                                break;
                            }

                        }
                        using (var stream = File.Create(destionationPath + "RQONE_" + Excahange_Protocol + "_" + issuereleasemapID + "_038_IssuereleasemapTargetValues_Before_Execution.xml"))
                        {

                            using (var writer = XmlWriter.Create(stream, settings))
                            {
                                xdoc.Save(writer);
                                objlogger.LogInfo("IssueReleaseMap Target Values Saved Successfully Before Execution");
                            }
                        }

                    }

                }

            }

            catch (Exception ex)
            {
                objlogger.LogInfo("Error in saving RQ1 Data File = " + ex.Message);
            }
        }

