        public XDocument GetLinkedRecord(XDocument xDocFeed, bool bLoopQueryResults = false, XElement xROIDRule = null)
        {
            XDocument xFromCQ = null;
            XElement xFilter = null, xFilterCondition =null;
            bool bLevel1 = false, bLevel2 = false, bFinal=false;
            string strURL = "", sLev1Operand1 = string.Empty, sLev1Operand2 = string.Empty, sLev2Operand1 = string.Empty, sLev2Operand2 = string.Empty;
            GlobalConstants.Operation Lev1operation = new GlobalConstants.Operation();
            GlobalConstants.Operation Lev2operation = new GlobalConstants.Operation();

            XElement xLink = xDocFeed.Descendants(nsoslc + "totalCount").Single();
            objlogger.LogInfo("Inside GetLinkedRecord: totalCount=" + xLink.Value, GlobalConstants.LOGGERLEVEL1);

            if (bLoopQueryResults==true & xROIDRule!=null)
            {
                //objlogger.LogInfo("Get FILTER elements");
                if (xROIDRule.Element(RulesFileTags.OPTCONDITION).Element(RulesFileTags.VIOLATIONHANDLER).Element(RulesFileTags.STRUCTURECHANGE).Element(RulesFileTags.FILTER) != null)
                {
                    //objlogger.LogInfo("Get FILTER elements");
                    xFilter = xROIDRule.Element(RulesFileTags.OPTCONDITION).Element(RulesFileTags.VIOLATIONHANDLER).Element(RulesFileTags.STRUCTURECHANGE).Element(RulesFileTags.FILTER).Element(RulesFileTags.MUSTCONDITION);
                    sLev1Operand1 = xFilter.Element(RulesFileTags.OPERAND1).Value;
                    sLev1Operand2 = xFilter.Element(RulesFileTags.OPERAND2).Value;
                    Lev1operation =
                        (GlobalConstants.Operation)Enum.Parse(typeof(GlobalConstants.Operation),
                        xFilter.Element(RulesFileTags.OPERATOR).Value, true);

                    objlogger.LogInfo("sLev1Operand1:" + sLev1Operand1 + " sLev1Operand2:" + sLev1Operand2 + " Lev1operation:" + Lev1operation.ToString(), GlobalConstants.LOGGERLEVEL2);

                    if(xFilter.Element(RulesFileTags.AND)!=null)
                    {
                        xFilterCondition = xFilter.Element(RulesFileTags.AND);
                    }
                    else if(xFilter.Element(RulesFileTags.OR)!=null)
                    {
                        xFilterCondition = xFilter.Element(RulesFileTags.OR);
                    }
                    else { }

                    if (xFilterCondition != null)
                    {
                        sLev2Operand1 = xFilter.Element(RulesFileTags.AND).Element(RulesFileTags.OPERAND1).Value;
                        sLev2Operand2 = xFilter.Element(RulesFileTags.AND).Element(RulesFileTags.OPERAND2).Value;
                        Lev2operation =
                            (GlobalConstants.Operation)Enum.Parse(typeof(GlobalConstants.Operation),
                            xFilter.Element(RulesFileTags.AND).Element(RulesFileTags.OPERATOR).Value, true);

                        objlogger.LogInfo("sLev2Operand1:" + sLev2Operand1 + " sLev2Operand2:" + sLev2Operand2 + " Lev2operation:" + Lev2operation.ToString(), GlobalConstants.LOGGERLEVEL2);
                    }
                    
                }
            }

            if (Convert.ToInt16(xLink.Value.ToString()) == 1)
            {
                //GetEvaluator IssueDBID
                var Entry = xDocFeed.Element(nsAtom + "feed").Element(nsAtom + "entry");
                if (Entry != null)
                {
                    var Link = Entry.Element(nsAtom + "link");
                    if (Link != null)
                    {
                        strURL = Link.Attribute("href").Value;
                        strURL = strURL + "?rcm.contentType=application/xml";
                        strURL = strURL.Replace(":12080", "");
                    }
                    else
                    {
                        strURL = "";
                    }
                }
                else
                {
                    strURL = "";
                }

                if (String.IsNullOrWhiteSpace(strURL)
                    == false)
                {
                    xFromCQ = InvokeURL(strURL);

                    //REUBK-3603
                    if (bLoopQueryResults == true)
                    {
                        string sLev1Value = string.Empty, sLev2Value = string.Empty;

                        //objlogger.LogInfo("Checking for ExternalID");
                        foreach (XElement xProperty in xFromCQ.Root.Elements())
                        {

                            string sAttr = xProperty.Name.ToString();
                            sAttr = sAttr.Replace("{", "");
                            sAttr = sAttr.Replace("}", "");
                            sAttr = sAttr.Replace("http://www.ibm.com/xmlns/prod/rational/clearquest/1.0/", "");
                            if (sAttr.ToUpper() == sLev1Operand1.Replace("$RO.",""))
                            {
                                if (!string.IsNullOrEmpty(xProperty.Value))
                                {
                                    sLev1Value = xProperty.Value.ToString();
                                }
                                else
                                {
                                    if (xProperty.HasAttributes)
                                    {
                                        //Reference field - sValue is link of record
                                        sLev1Value = xProperty.FirstAttribute.Value;
                                    }
                                }

                                objlogger.LogInfo("sLev1Value = " + sLev1Value, GlobalConstants.LOGGERLEVEL2);
                            }
                            else if (sAttr.ToUpper() == sLev2Operand1.Replace("$RO.", ""))
                            {
                                if (!string.IsNullOrEmpty(xProperty.Value))
                                {
                                    sLev2Value = xProperty.Value.ToString();
                                }
                                else
                                {
                                    if (xProperty.HasAttributes)
                                    {
                                        //Reference field - sValue is link of record
                                        sLev2Value = xProperty.FirstAttribute.Value;
                                    }
                                }

                                objlogger.LogInfo("sLev2Value = " + sLev2Value, GlobalConstants.LOGGERLEVEL2);
                            }
                            else { }
                        }

                       bLevel1 = Utilities.PerformOperation(sLev1Value, sLev1Operand2, Lev1operation,false,string.Empty);
                       objlogger.LogInfo("bLevel1 = " + bLevel1.ToString(), GlobalConstants.LOGGERLEVEL2);
                       if (xFilterCondition != null)
                       {
                           bLevel2 = Utilities.PerformOperation(sLev2Value, sLev2Operand2, Lev2operation, false, string.Empty);
                           objlogger.LogInfo("bLevel2 = " + bLevel2.ToString(), GlobalConstants.LOGGERLEVEL2);
                           if(xFilterCondition.Value == RulesFileTags.AND)
                           {
                               bFinal = (bLevel1 & bLevel2);
                           }
                           else
                           {
                               if(xFilterCondition.Value == RulesFileTags.OR)
                               {
                                   bFinal = (bLevel1 || bLevel2);
                               }
                           }
                       }
                       else
                       { bFinal = bLevel1; }

                       //objlogger.LogInfo("bFinal = " + bFinal.ToString());
                       if (bFinal)
                       {
                           xFromCQ = null;
                           //objlogger.LogInfo("Setting xFromCQ to null");
                       }
                               
                    }
                }
                else
                { xFromCQ = null; }
            }
            else if (Convert.ToInt16(xLink.Value.ToString()) > 1)
            {
                XDocument xResponse = null;
                //int iMainRecCount = 0;
                var Entries = xDocFeed.Element(nsAtom + "feed").Elements(nsAtom + "entry");
                foreach (var Entry in Entries)
                {
                    if (Entry != null)
                    {
                        var Link = Entry.Element(nsAtom + "link");
                        if (Link != null)
                        {
                            strURL = Link.Attribute("href").Value;
                            strURL = strURL + "?rcm.contentType=application/xml";
                            strURL = strURL.Replace(":12080", "");
                        }
                        else
                        {
                            strURL = "";
                        }
                    }
                    else
                    {
                        strURL = "";
                    }

                    if (String.IsNullOrWhiteSpace(strURL)
                        == false)
                    {
                        xResponse = InvokeURL(strURL);
                         //REUBK-3603
                        if (bLoopQueryResults == true)
                        {
                            string sLev1Value = string.Empty, sLev2Value = string.Empty;
                            objlogger.LogInfo("Checking for ExternalID", GlobalConstants.LOGGERLEVEL2);
                            foreach (XElement xProperty in xResponse.Root.Elements())
                            {
                                string sAttr = xProperty.Name.ToString();
                                sAttr = sAttr.Replace("{", "");
                                sAttr = sAttr.Replace("}", "");
                                sAttr = sAttr.Replace("http://www.ibm.com/xmlns/prod/rational/clearquest/1.0/", "");
                                if (sAttr.ToUpper() == sLev1Operand1.Replace("$RO.", ""))
