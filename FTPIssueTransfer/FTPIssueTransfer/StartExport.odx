                [Microsoft.XLANGs.BaseTypes.DesignerPosition("55bb3a4e-6ba0-44c4-99ff-346d9b5a861b")]
                ExportTransferResultInfo_msg.LifeToken4XProt = LifeToken4XProt;
                ExportTransferResultInfo_msg.LifeToken4Files = LifeToken4Files;
                
                tmp_str1 = ExportTransferResultInfo_msg.RQ1System;
                tmp_str2 = tmp_str1.Substring(tmp_str1.LastIndexOf("@")+1);
                
                ExportTransferResultInfo_msg(FILE.ReceivedFileName) = tmp_str2 + "_" + ExportTransferResultInfo_msg.XProtID + "_005_FTPTransferResult_";
            }
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("0c926a80-42d7-4a15-ace2-ddb528e04ccc")]
            send (EX_R.Operation_1, ExportTransferResultInfo_msg);
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("176c0997-2b05-41f7-9e38-6eab8ab32673")]
            send (EX_R_CPY.Operation_1, ExportTransferResultInfo_msg);
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("69c11ac5-e61d-4ecb-9e4a-36964d75b382")]
            ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmss - }", System.DateTime.Now) + "FTPIssueTransfer : " + "Export Transfer Result Information file is successfully generated",ROLogger);
            ROBTLogger.CloseLogger(ROLogger);
        }
    }
}

