[Microsoft.XLANGs.BaseTypes.BPELExportable(false)]
module FTPRecordTransfer
{
    public porttype PortType_5
    {
        requestresponse Operation_1
        {
            FTPIssueTransfer.StartExportRequest, FTPIssueTransfer.StartExportRequest
        };
    };
    public porttype PortType_1
    {
        oneway Operation_1
        {
            FTPIssueTransfer.TransferResultInformation
        };
    };
    public porttype PortType_2
    {
        oneway Operation_1
        {
            FTPIssueTransfer.TransferResultInformation
        };
    };
    [Microsoft.XLANGs.BaseTypes.BPELExportable(false)]
    internal service StartExport
    {
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port implements PortType_5 EX_P;
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port uses PortType_1 EX_R;
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port uses PortType_2 EX_R_CPY;
        message FTPIssueTransfer.StartExportRequest Message_1;
        message FTPIssueTransfer.TransferResultInformation ExportTransferResultInfo_msg;
        RB.BTLoggerLibrary.Logger ROLogger;
        RB.BTLoggerLibrary.BTLogger ROBTLogger;
        System.String InterfaceName;
        System.String TargetSystem;
        System.String LifeToken4XProt;
        System.String LifeToken4Files;
        System.String tmp_str1;
        System.String type;
        System.String tmp_str2;
        body ()
        {
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("9b724ee7-8871-406f-a917-e57da6b74875")]
            activate receive (EX_P.Operation_1, Message_1);
            ROBTLogger = new RB.BTLoggerLibrary.BTLogger();
            InterfaceName = "";
            TargetSystem = "";
            LifeToken4XProt = "";
            LifeToken4Files = "";
            tmp_str1 = "";
            type = "";
            tmp_str2 = "";
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("4c9b7088-c102-4682-b0d9-c1abe0329dc4")]
            System.Diagnostics.EventLog.WriteEntry("FTPIssueTransfer","Export Request received at "+System.String.Format("{0:yyyyMMdd-HHmmssffffff - }", System.DateTime.Now));
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("3a782c69-63c5-4ad5-a0b1-ef864c78eb6d")]
            type = "Export";
            ROLogger  = ROBTLogger.GetLogger(Message_1.InterfaceName,Message_1.XProtID, type);
            ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmssffffff - }", System.DateTime.Now) + "After receiving Request",
            ROLogger);
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("f65acc89-027c-413f-9cfd-423df052e7d9")]
            InterfaceName = System.Convert.ToString(Message_1.InterfaceName);
            ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmss - }", System.DateTime.Now) + "FTPIssueTransfer :InterfaceName  : " + InterfaceName,ROLogger);
            TargetSystem = System.Convert.ToString(Message_1.RQ1System);
            ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmss - }", System.DateTime.Now) + "FTPIssueTransfer :TargetSystem  : " + TargetSystem,ROLogger);
            LifeToken4XProt = "In Progress";
            ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmss - }", System.DateTime.Now) + "FTPIssueTransfer :LifeToken4Xprot  : " + LifeToken4XProt,ROLogger);
            tmp_str1 = Message_1.FTPFileNames;
            ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmss - }", System.DateTime.Now) + "FTPIssueTransfer :RecordNames  : " + tmp_str1,ROLogger);
            LifeToken4Files = ROBTLogger.InsertAllTokenStatus(tmp_str1, "In Progress",type);
            ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmss - }", System.DateTime.Now) + "FTPIssueTransfer : LifeToken4Files  : " + LifeToken4Files,ROLogger);
            
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("d13b7454-2dd6-4a63-adb2-d227eabb12ad")]
            send (EX_P.Operation_1, Message_1);
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("46d54810-a7f7-45e8-8aa7-96dc41058398")]
            construct ExportTransferResultInfo_msg
            {
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("56d01bc4-ae98-484f-a485-7052fe894da9")]
