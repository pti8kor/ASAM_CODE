                //System.Diagnostics.EventLog.WriteEntry("Biztalk : SingleFileDownload - raw value", tmp_str1, System.Diagnostics.EventLogEntryType.Information);
                System.Diagnostics.EventLog.WriteEntry("Biztalk : SingleFileDownload - single file", tmp_str1, System.Diagnostics.EventLogEntryType.Information);
                
