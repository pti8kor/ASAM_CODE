            //tmp_str1 = Message_1.FTPFileNames;
            tmp_str1 = FTPHandler1.GetFileNamesForXPROTCreation(Message_1.FTPFileNames);
            
            ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmss - }", System.DateTime.Now) + "FTPIssueTransfer : GetFileNamesForXPROTCreation  : " + tmp_str1,
            ROLogger);
            
            tmp_str4 = tmp_str1;
            
            //Check for Sorting
            if(FTPHandler1.canSortFiles =="1")
            {
                tmp_str1 = FTPHandler1.GetSortedFiles(tmp_str1);
                ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmss - }", System.DateTime.Now) + "FTPIssueTransfer : GetSortedFiles  : " + tmp_str1,ROLogger);
            }
            
            // storing the sorted files in a string.
            tmp_str5 = tmp_str1;
            
            // Initialisation
            LifeToken4XProt = "In Progress";
            LifeToken4Files = ROBTLogger.InsertAllTokenStatus(tmp_str4, "In Progress", "import");
            ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmss - }", System.DateTime.Now) + "FTPIssueTransfer : LifeToken4Files  : " + LifeToken4Files,ROLogger);
            
            //>LifeToken4Files = RB.BTLogger.BTLogger.SetTokenStatus(LifeToken4Files, Filename, "In Progress");
            //>Status = RB.BTLogger.BTLogger.GetTokenStatus(LifeToken4Files, Filename);
            
            ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmss - }", System.DateTime.Now) + "FTPIssueTransfer : " + "XProtID ->" + tmp_str2 +  "; Download FileList -> " + tmp_str1,
            ROLogger);
            
            //ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmss - }", System.DateTime.Now) + "FTPIssueTransfer : Download directory : " + DLDirName,ROLogger);
            
            
            System.Diagnostics.EventLog.WriteEntry("Biztalk : FTPFilenames raw", tmp_str1 , System.Diagnostics.EventLogEntryType.Information);
            
            FileNames = FTPHandler1.ConvertToLines(tmp_str4,",");
            
            System.Diagnostics.EventLog.WriteEntry("Biztalk : FTPFilenames in Lines", FileNames , System.Diagnostics.EventLogEntryType.Information);
            ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmss - }", System.DateTime.Now) + "FileNames : " + FileNames,
            ROLogger);
            
            ChildNumber = FTPHandler1.CountStringLines(FileNames);
            
            System.Diagnostics.EventLog.WriteEntry("Biztalk : ChildNumber", System.Convert.ToString(ChildNumber), System.Diagnostics.EventLogEntryType.Information);
            
            LoopCounter = 1;
            
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("85e3fb3d-1160-48fe-97cc-542e6fd357a9")]
            while (LoopCounter <= ChildNumber)
            {
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("77519480-c6ff-40bc-aace-71b2815459a5")]
                tmp_str1 = FTPHandler1.ReadStringLine(FileNames, LoopCounter);  // contains single file name
                
