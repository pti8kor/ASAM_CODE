                		ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmss - }", System.DateTime.Now) + "FTPIssueTransfer : " + "CheckCommercialFiles ->" + System.Convert.ToString(retVar1.rSuccess),
                		ROLogger);
                		if (retVar1.rSuccess == true)
                		{
                			ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmss - }", System.DateTime.Now) + "FTPIssueTransfer : " + "CheckCommercialFiles FileNamesCom->" + retVar1.rString,
                			ROLogger);
                			FileNamesCom = System.Convert.ToString(retVar1.rString);
                
                			//Zugriff auf lokales File
                			ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmss - }", System.DateTime.Now) + "FTPIssueTransfer : " + "CheckCommercialFiles -call GetAttachmentNames->",
                			ROLogger);
                			retVar2 = FTPHandler1.GetAttachmentNames(tmp_str1, DLDirName,false);
                			tmp_str2 = System.Convert.ToString(retVar2.rMessage);
                			//retVar2-error not yet handled explicitly
                			
                				ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmss - }", System.DateTime.Now) + "FTPIssueTransfer : " + "CheckCommercialFiles - GetAttachmentNames->" + tmp_str2,
                			ROLogger);
                
                			ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmss - }", System.DateTime.Now) + "FTPIssueTransfer : " + "Attachments queued for download ->" + tmp_str1,ROLogger);
                			ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmss - }", System.DateTime.Now) + "FTPIssueTransfer : " + "AttachmentsDownload result ->" + tmp_str2,ROLogger);
                
                			ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmss - }", System.DateTime.Now) + "FTPIssueTransfer : " +  "ASAM file "+tmp_str1 + "LifeToken4Files" + LifeToken4Files,ROLogger);
                			
                			if (ROBTLogger.GetTokenStatusForFile(LifeToken4Files, tmp_str1)!="Failure")
                			{
                				ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmss - }", System.DateTime.Now) + "FTPIssueTransfer : " +  "ASAM file status is not failure "+tmp_str1 +LifeToken4Files,ROLogger);
                				if (System.Text.RegularExpressions.Regex.IsMatch(tmp_str2,".*failure:.*"))
                				{
                					//REUBK-1388
                					ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmss - }", System.DateTime.Now) + "FTPIssueTransfer : " + "ASAM file attachment status is failure "+tmp_str2,ROLogger);
                					//tmp_str3 = System.Text.RegularExpressions.Regex.Replace(tmp_str2, ".*failure:([^,]+).*", "$1");
                					tmp_str3 = System.Text.RegularExpressions.Regex.Replace(tmp_str2, ".*failure:([^·]+).*", "$1");
                						ROBTLogger.WriteLog( System.String.Format("{0:yyyyMMdd-HHmmss - }", System.DateTime.Now) + "FTPIssueTransfer : " + "ASAM file attachment status is failure "+tmp_str3,ROLogger);
                					LifeToken4Files = ROBTLogger.SetTokenStatus(LifeToken4Files, tmp_str1, "Failure", tmp_str3);
                				}
                				else
                				{
                					ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmss - }", System.DateTime.Now) + "FTPIssueTransfer : " +  "set status to Inprogress" ,ROLogger);
                					LifeToken4Files = ROBTLogger.SetTokenStatus(LifeToken4Files, tmp_str1, "In Progress","");
                				}
                			}
                			else
                			{
                			ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmss - }", System.DateTime.Now) + "FTPIssueTransfer : " +  "ASAM file status is failure "+ tmp_str1,ROLogger);
                			}
                		}
                		else
                		{
                		ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmss - }", System.DateTime.Now) + "FTPIssueTransfer : " + "CheckCommercialFiles -> inside failure case" ,
                		ROLogger);
                			LifeToken4Files = ROBTLogger.SetTokenStatus(LifeToken4Files, tmp_str1, "Failure", System.Convert.ToString(retVar1.rMessage));
                		}
                	}
                	else
