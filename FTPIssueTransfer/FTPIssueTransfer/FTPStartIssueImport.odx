                [Microsoft.XLANGs.BaseTypes.DesignerPosition("4746bd86-8b04-4382-88e7-5f5f4538954e")]
                LifeToken4XProt = ROBTLogger.GetOverallTokenStatus(LifeToken4Files);
                //>if LifeToken4XProt = "Failure" ....
                
                Message_2 = Message_1;
                // BTLogger-Message only, because this line is available already in ExchangeProtocol-Log :
                ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmss - }", System.DateTime.Now) + "FTPIssueTransfer : " + "Result of xml downloads -> " + LifeToken4XProt,
                ROLogger);
                //ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmss - }", System.DateTime.Now) + "FTPIssueTransfer : " + "Exchange protocol queued for import -> " + Message_2.XProtID,ROLogger);
                
                
                // reduce message text in XProt
                //Message_2.BTReturnMsg = ROLogText; 
                Message_2.BTReturnMsg = "";
                
                //ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmss - }", System.DateTime.Now) + "FTPIssueTransfer : " + "BTReturnMsg ->" +Message_2.BTReturnMsg +"-",ROLogger);
                //ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmss - }", System.DateTime.Now) + "FTPIssueTransfer : " + "ReturnMsg Files ->" +Message_2.FTPFileNames +"-",ROLogger);
                
                //FTPIssueTransfer_Project.PropertySchema.FileName) = Message_2.GetPropertyValue(typeof(FTPHandler.ParseFTPListStream(FTPStream)));
                
                
                Message_2 = FTPHandler1.AddDummyTagToResponse(Message_2);
                ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmss - }", System.DateTime.Now) + "FTPIssueTransfer : " + "Added Dummy tag to response",ROLogger);
            }
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("a34056f3-e6dd-4296-b6e0-1a69768a1ba2")]
            send (RR_P.Operation_1, Message_2);
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("a4cf53ec-e2ab-4907-9afb-cbbbf9a3c12f")]
            //System.Diagnostics.EventLog.WriteEntry("FTPIssueTransfer","After sending Response "+System.String.Format("{0:yyyyMMdd-HHmmssffffff - }", System.DateTime.Now));
            ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmssffffff - }", System.DateTime.Now) + "After sending Response",
            ROLogger);
            
            LoopCounter = 1;
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("e1ef5518-eec4-4da3-893c-24333370a024")]
            while (LoopCounter <= ChildNumber)
            {
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("611cf214-8376-48d6-b5d4-94d3cb168dca")]
                   //REUBK-2187
                
                tmp_str1 = FTPHandler1.ReadStringLine(FileNames, LoopCounter); // contains single file name
                
                tmp_str1 = ROBTLogger.GetFileName(LifeToken4Files,tmp_str1); //get modified asam file name based on new token
                
