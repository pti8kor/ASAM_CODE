[Microsoft.XLANGs.BaseTypes.BPELExportable(false)]
module FTPIssueTransfer
{
    public porttype RequestResponse_Type
    {
        requestresponse Operation_1
        {
            StartImportSchema, StartImportSchema
        };
    };
    internal porttype PortType_1
    {
        oneway Operation_1
        {
            TransferResultInformation
        };
    };
    internal porttype PortType_2
    {
        oneway Operation_1
        {
            TransferResultInformation
        };
    };
    internal porttype PortType_req
    {
        oneway Operation_1
        {
            StartImportSchema
        };
    };
    internal porttype PortType_res
    {
        oneway Operation_1
        {
            StartImportSchema
        };
    };
    [Microsoft.XLANGs.BaseTypes.BPELExportable(false)]
    internal service FTPStartIssueImport
    {
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port implements RequestResponse_Type RR_P;
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port uses PortType_1 TR_P;
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port uses PortType_2 TR_CPY;
        message TransferResultInformation Message_3;
        message StartImportSchema Message_1;
        message StartImportSchema Message_2;
        System.Int32 ChildNumber;
        System.Int32 LoopCounter;
        System.String tmp_str1;
        System.String tmp_str2;
        System.String FileNames;
        System.String DLDirName;
        System.String InterfaceName;
        System.Boolean result;
        RB.FTPLibrary.FTPHandler FTPHandler1;
        System.String LifeToken4Files;
        System.String LifeToken4XProt;
        System.String tmp_str3;
        System.String FileNamesCom;
        RB.FTPLibrary.retStrBool retVar1;
        RB.FTPLibrary.retStrBool retVar2;
        System.String TargetSystem;
        RB.BTLoggerLibrary.ROUpdater ROUpdater1;
        RB.BTLoggerLibrary.Logger ROLogger;
        System.Boolean resultCharCheck;
        RB.FTPLibrary.retStrBool retVar3;
        System.String TransferMode;
        RB.BTLoggerLibrary.BTLogger ROBTLogger;
        System.String DLDirOut;
        System.Boolean isMsgAck;
        System.String tmp_str4;
        System.Boolean isValid;
        System.String tmp_str5;
        System.String unModifiedAIFileName;
        System.Boolean isattachmentValid;
        body ()
        {
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("bb436360-b0ac-48f7-87d8-fd2073c65120")]
            activate receive (RR_P.Operation_1, Message_1);
            tmp_str1 = "";
            tmp_str2 = "";
            FileNames = "";
            DLDirName = "";
            InterfaceName = "";
            result = true;
            FTPHandler1 = new RB.FTPLibrary.FTPHandler();
            LifeToken4Files = "";
            LifeToken4XProt = "";
            tmp_str3 = "";
            FileNamesCom = "";
            retVar1 = new RB.FTPLibrary.retStrBool();
            retVar2 = new RB.FTPLibrary.retStrBool();
            TargetSystem = "";
            ROUpdater1 = new RB.BTLoggerLibrary.ROUpdater();
            resultCharCheck = true;
            retVar3 = new RB.FTPLibrary.retStrBool();
            TransferMode = "";
            ROBTLogger = new RB.BTLoggerLibrary.BTLogger();
            DLDirOut = "";
            isMsgAck = true;
            tmp_str4 = "";
            isValid = true;
            tmp_str5 = "";
            unModifiedAIFileName = "";
            isattachmentValid = true;
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("66130cf7-920e-44e7-8df0-2dabfbd86f6e")]
            System.Diagnostics.EventLog.WriteEntry("FTPIssueTransfer","Request received at "+System.String.Format("{0:yyyyMMdd-HHmmssffffff - }", System.DateTime.Now));
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("c9cae778-de51-4acb-ba3f-9c3cd584daf4")]
            ROLogger  = ROBTLogger.GetLogger(Message_1.InterfaceName,Message_1.XProtID, "Import");
            ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmssffffff - }", System.DateTime.Now) + "After receiving Request",
            ROLogger);
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("521a27de-b290-4a19-a00f-89bc7d3b27d2")]
            
            tmp_str1 = Message_1.RQ1System;
            tmp_str2 = Message_1.XProtID;
            InterfaceName = System.Convert.ToString(Message_1.InterfaceName);
            TargetSystem = System.Convert.ToString(Message_1.RQ1System);
            
            FTPHandler1 = new RB.FTPLibrary.FTPHandler(InterfaceName, TargetSystem);
            
            // Fehlerbehandlung notwendig : sind Zeichen enthalten, die nicht in Dir-Namen verwendet werden dürfen? zB "\:"
