             //ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmss - }", System.DateTime.Now) + "Download directory before : ", ROLogger);
            
             DLDirName = System.String.Format("{0:yyyyMMdd-HHmmss_}", System.DateTime.Now) + tmp_str1 + "_" + tmp_str2; 
