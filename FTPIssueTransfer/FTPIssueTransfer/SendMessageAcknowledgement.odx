t;+ xprotID);&#xD;&#xA;ROLogger = ROBTLogger.GetLogger(interfaceName,xprotID,&quot;Import&quot;);&#xD;&#xA;ROBTLogger.WriteLog(System.String.Format(&quot;{0:yyyyMMdd-HHmmss - }&quot;, System.DateTime.Now) + &quot;Setting log for msg acknowledgement&quot;,ROLogger);&#xD;&#xA;category = System.Convert.ToString(xpath(receivedMsg,&quot;string(/*[local-name()='transmitterRequest' and namespace-uri()='http://FTPIssueTransfer.InitialTransmitterRequestSchema']/*[local-name()='Category' and namespace-uri()=''])&quot;));&#xD;&#xA;System.Diagnostics.EventLog.WriteEntry(&quot;FTPIssueTransfer&quot;,&quot;Transmitter Request Category: &quot;+ category);" />
