    [Microsoft.XLANGs.BaseTypes.BPELExportable(false)]
    internal service FileShift
    {
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port implements ReceiveImportResultPortType ReceiveImportResultPort;
        [Microsoft.XLANGs.BaseTypes.PhysicalBinding(typeof(Microsoft.BizTalk.DefaultPipelines.XMLTransmit))]
        port uses dynamic PortType_ACK PortsndACK1;
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port uses PortType_1 sndError;
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port uses PortType_8 TransmitterRequestSendPort;
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port uses PortType_9 TransmitterRequestCopyPort;
        message FTPIssueTransfer_DEV.SingleFileShiftInformation msgSingleFileImportResult;
        message System.Xml.XmlDocument msgACK;
        message System.Xml.XmlDocument msgError;
        message System.Xml.XmlDocument msgTxReq;
        message FTPIssueTransfer.InitialTransmitterRequestSchema msgTransmitterREQCopy;
        message FTPIssueTransfer.InitialTransmitterRequestSchema msgTransmitterREQ;
        System.String SuccFileNameList;
        System.String tmpStr1;
        System.String shiftResult;
        RB.BTLoggerLibrary.BTLogger ROBTLogger;
        RB.BTLoggerLibrary.Logger ROLogger;
        System.String sACKFileName;
        System.String sACKFileNameWO;
        System.String sFolderName;
        System.String sTemp;
        System.Boolean bACKFileExists;
        RB.FTPLibrary.FTPHandler FTPHandler1;
        System.String sDownloadHost;
        System.Int32 iDelayTime;
        body ()
        {
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("1bb18933-1f9f-4f56-8b1f-d0be090b7fe2")]
            activate receive (ReceiveImportResultPort.Operation_1, msgSingleFileImportResult);
            SuccFileNameList = "";
            tmpStr1 = "";
            shiftResult = "";
            ROBTLogger = new RB.BTLoggerLibrary.BTLogger();
            sACKFileName = "";
            sACKFileNameWO = "";
            sFolderName = "";
            sTemp = "";
            bACKFileExists = true;
            sDownloadHost = "";
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("b9cbc59d-0425-49ca-9b86-424802cce2f1")]
            System.Diagnostics.EventLog.WriteEntry("FILESHIFT","Inside fileshift orch" );
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("7096ad74-f0a9-4028-b627-012c74a0e8e9")]
             ROLogger  = ROBTLogger.GetLogger(msgSingleFileImportResult.InterfaceName,msgSingleFileImportResult.XProtID, "Import");
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("9859b988-fdd3-4286-b0fd-84fdd25c1dcd")]
            
            FTPHandler1 = new RB.FTPLibrary.FTPHandler(msgSingleFileImportResult.InterfaceName, msgSingleFileImportResult.RQ1System);
            
            if(msgSingleFileImportResult.Mode == "Automatic")
            {
            ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmss - }", System.DateTime.Now) + "FILESHIFT for Automatic mode" ,
            ROLogger);
                FTPHandler1.GetDateTimeFolderBasedOnMode(msgSingleFileImportResult.DownloadTargetPath);
            }
            
            
            
            
            System.Diagnostics.EventLog.WriteEntry("FILESHIFT","checkstatus=" +msgSingleFileImportResult.Status);
            //REUBK-1592 SingleFileShift
            
            //fetch next Filename to tmpStr1
            ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmss - }", System.DateTime.Now) + "FILESHIFT - import status = " + msgSingleFileImportResult.Status,
            ROLogger);
            
            SuccFileNameList = msgSingleFileImportResult.FileName;
            
            tmpStr1 = FTPHandler1.ReadStringLine(SuccFileNameList, 1);
            
            ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmss - }", System.DateTime.Now) + "callin shift source file",
            ROLogger);
            System.Diagnostics.EventLog.WriteEntry("FILESHIFT","call ShiftSourceFile");
            shiftResult = FTPHandler1.ShiftSourceFile(tmpStr1,msgSingleFileImportResult.XProtID,msgSingleFileImportResult.DownloadTargetPath,msgSingleFileImportResult.DownloadTime,msgSingleFileImportResult.Status);
            
            ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmss - }", System.DateTime.Now) + "FTPShiftFile : ShiftSourceFileFile <" + tmpStr1 +"> " + shiftResult,
            ROLogger);
            
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("f149725d-d1cc-47ad-9388-ad4e601fe08c")]
            System.Diagnostics.EventLog.WriteEntry("FILESHIFT","TransactionID=" +msgSingleFileImportResult.TransactionID);
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("63ce9f27-d47b-4ff3-9671-a97fa227870d")]
            if (FTPHandler1.canShiftACK == "1" && msgSingleFileImportResult.TransactionID != "" )
            {
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("e2b61a6b-9850-4ea0-837e-6010002e440a")]
                
                System.Diagnostics.EventLog.WriteEntry("FILESHIFT","construct ack msg");
                
                ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmss - }", System.DateTime.Now) + "start TransferACK",
                ROLogger);
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("72d14793-ac58-4592-bd33-45f69d6ed0a9")]
                construct msgACK
                {
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("144b9e3f-16a7-4872-a8b0-2ea6a8cf48db")]
                    //ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmss - }", System.DateTime.Now) + "inside set msgACK",ROLogger);
                    
                    msgACK = FTPHandler1.SetValuesForACK(msgSingleFileImportResult.TransactionID,msgSingleFileImportResult.StatusInfo,msgSingleFileImportResult.Status);
                    
                    ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmss - }", System.DateTime.Now) + "set SetTAFileName",
                    ROLogger);
                    
                    sACKFileName = FTPHandler1.SetTAFileName(msgSingleFileImportResult.FileName, ROLogger);
                    sACKFileNameWO = FTPHandler1.GetFileNameWithoutExtn(sACKFileName);
                    
                    ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmss - }", System.DateTime.Now) + "sACKFileName=" +sACKFileName,
                    ROLogger);
                    
                    
                    //msgTxReq = FTPHandler1.FrameMsgACKREQ(msgACK,sACKFileName);
                    //ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmss - }", System.DateTime.Now) + "set msgTxReq",ROLogger);
                    //msgREQ.transmitterRequest = msgTxReq;
                    
                }
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("f95f9268-14f0-4fdc-bf62-3cd992cd7c59")]
                sFolderName = FTPHandler1.GetFormattedDateTime(msgSingleFileImportResult.DownloadTime)+ "_"+ msgSingleFileImportResult.XProtID;
                sFolderName ="D:\\ASAM-IF-IMPORT\\Import\\082 - TransferAcknowledgment\\"+sFolderName;
                
                System.IO.Directory.CreateDirectory(sFolderName);
                ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmssffffff - }", System.DateTime.Now) + "Framing dynamic port name",
                ROLogger);
                PortsndACK1(Microsoft.XLANGs.BaseTypes.Address) = "file://" + sFolderName + "/" + sACKFileName;
                //ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmssffffff - }", System.DateTime.Now) + "Before dynamic port creation",ROLogger);
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("63bdfffd-2ad6-443a-a8df-56b3161a814a")]
                send (PortsndACK1.Operation_1, msgACK);
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("877b6a75-b888-4cb1-8bd5-72c53eaf9f8f")]
                System.Diagnostics.EventLog.WriteEntry("FILESHIFT","after sending file to ACk folder");
                ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmssffffff - }", System.DateTime.Now) + "After dynamic port creation",
                ROLogger);
                
                iDelayTime = System.Convert.ToInt32(FTPHandler1.ACKDelayTime);
                ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmssffffff - }", System.DateTime.Now) + "Introducing delay time of "+ iDelayTime.ToString() +" millisec",
                ROLogger);
                System.Threading.Thread.Sleep(iDelayTime);
                
                ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmssffffff - }", System.DateTime.Now) + "Checking if ACK file exists after delay time",
                ROLogger);
                 
                bACKFileExists = FTPHandler1.CheckACKFileExists(msgSingleFileImportResult.XProtID,msgSingleFileImportResult.DownloadTime,sACKFileName);
                
                ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmssffffff - }", System.DateTime.Now) + "bACKFileExists:"+bACKFileExists.ToString(),
                ROLogger);
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("f9a25805-2d3f-445f-8675-6d59d1a5fbdd")]
                if (bACKFileExists == true)
                {
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("285a97ac-24b5-4bb8-809d-bf83c149bf03")]
                    construct msgTxReq, msgTransmitterREQ
                    {
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("ae9c067f-3f92-4a63-98ac-20dc476c44a7")]
                        ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmss - }", System.DateTime.Now) + "Frame msgTxReq",ROLogger);
                        
                        
                        //For Zip file transfer
                        msgTxReq = FTPHandler1.FrameMsgACKREQ(sFolderName,sACKFileNameWO,msgSingleFileImportResult.RQ1System,msgSingleFileImportResult.InterfaceName,msgSingleFileImportResult.XProtID, ROLogger, msgSingleFileImportResult.Category);
                        
                        //For normal xml transfer
                        //msgTxReq = FTPHandler1.FrameMsgACKREQ(msgACK,sACKFileName);
                        
                        //ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmss - }", System.DateTime.Now) + "Set msgTxReq",ROLogger);
                        
                        msgTransmitterREQ = msgTxReq;
                        
                    }
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("50f95b09-0ceb-4f67-b402-cfa3b4a3af24")]
                    System.Diagnostics.EventLog.WriteEntry("FILESHIFT","call TransferACKFile");
                    ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmss - }", System.DateTime.Now) + "callin TransferACKFile",
                    ROLogger);
                    shiftResult = FTPHandler1.TransferACKFile(sACKFileName,msgSingleFileImportResult.DownloadTime,msgSingleFileImportResult.XProtID);
                    
                    //ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmss - }", System.DateTime.Now) + " aft callin TransferACKFile" +shiftResult,ROLogger);
                    
                    ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmss - }", System.DateTime.Now) + "FTPShiftFile : TransferACKFile for <" + sACKFileName +"> " + shiftResult,
                    ROLogger);
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("78e6976a-9bb4-4786-9a28-fd89b6ff504b")]
                    System.Diagnostics.EventLog.WriteEntry("FILESHIFT","send wb servicerq to sendport" );
                    tmpStr1=msgSingleFileImportResult.TransactionID;
                    ROBTLogger.WriteLog(System.String.Format("{0:yyyyMMdd-HHmmss - }", System.DateTime.Now) + "FTPShiftFile : TransactionID is" + tmpStr1,
                    ROLogger);
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("44c24508-ed2e-4079-b4d6-438851e03aeb")]
                    send (TransmitterRequestSendPort.Operation_1, msgTransmitterREQ);
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("9e356cc7-4d38-4c18-9419-e86d5ad380cd")]
                    construct msgTransmitterREQCopy
                    {
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("880170a8-8496-4492-9bb9-cad436a8b32c")]
                        msgTransmitterREQCopy = msgTransmitterREQ;
                        sDownloadHost = msgSingleFileImportResult.RQ1System;
                        sDownloadHost = sDownloadHost.Substring(sDownloadHost.LastIndexOf("@")+1);
                        msgTransmitterREQCopy(FILE.ReceivedFileName) = sDownloadHost + "_" + msgSingleFileImportResult.XProtID +"_083_" +"TransmitterRequest_" + sACKFileNameWO; 
                    }
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("e01a6165-2d7e-4c60-b963-ac4b84136cc8")]
                    send (TransmitterRequestCopyPort.Operation_1, msgTransmitterREQCopy);
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("664dacdc-0256-45e0-81ad-feb8c34d26da")]
